# Portainer 의 "Environment variables" (Advanced mode) 에 붙여넣거나,
# 로컬에서는 `cp .env.example .env` 후 값을 채워 사용하세요.
# 비밀번호는 `openssl rand -hex 24` 처럼 특수문자 없는 값을 권장합니다.

# --- 필수 (docker compose) ---
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- 최초 실행 시 만들어질 관리자 계정 (사용자가 한 명도 없을 때만 사용, 이후 지워도 됩니다) ---
# 예전 이름 ID / PW 로 넣어도 인식합니다.
ADMIN_ID=
ADMIN_PASSWORD=

# --- 선택 ---
# 서비스가 노출될 주소. 짧은 주소 앞에 이 주소가 붙습니다.
TARGET_URL=http://localhost:6824/
# 호스트에 열 포트 (컨테이너 내부 포트는 3000 고정)
APP_PORT=6824
# 화면 왼쪽 위에 보여질 이름
SERVICE_NAME=MrShort
POSTGRES_USER=mrshort
POSTGRES_DB=urlshortener

# 리버스 프록시(nginx, Traefik 등) 뒤에서 쓰면 1 (또는 true) 로 설정하세요.
# 설정하지 않으면 접속자 IP 가 모두 프록시 IP 로 보여 로그인 시도 제한이 제대로 동작하지 않습니다.
TRUST_PROXY=false
# 쿠키의 Secure 속성. auto 는 https 로 접속했을 때만 붙입니다. (true / false 로 고정 가능)
COOKIE_SECURE=auto
# 다른 도메인에서 이 서비스를 호출하는 것을 허용할 때만 쉼표로 구분해 적습니다. (보통 비워 둡니다)
ALLOWED_ORIGINS=

# 이전 버전(SHA-256 해시)에서 업데이트하는 경우, 그때 쓰던 HASH_SALT 를 그대로 넣으세요.
# 기존 계정이 로그인할 때 안전한 해시(argon2)로 자동 교체됩니다. 새 설치는 비워 두세요.
HASH_SALT=

# --- 로컬 개발용 (docker-compose.dev.yml 과 같은 값) ---
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=mrshort
# DB_PASSWORD=devpass
# DB_DATABASE=mrshort
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=devpass

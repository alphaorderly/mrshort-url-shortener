# Portainer 의 "Environment variables" (Advanced mode) 에 붙여넣거나,
# 로컬에서는 `cp .env.example .env` 후 값을 채워 사용하세요.
# 시크릿은 `openssl rand -hex 64` 로 생성합니다. ($ 같은 특수문자가 없는 hex 를 권장)

# --- 필수 ---
# JWT_SECRET 과 JWT_REFRESH_SECRET 은 반드시 서로 다른 값을 사용하세요.
JWT_SECRET=
JWT_REFRESH_SECRET=
# 비밀번호 해시 솔트. 운영 중 바꾸면 기존 계정으로 로그인할 수 없게 됩니다.
HASH_SALT=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- 최초 실행 시 만들어질 기본 계정 (사용자가 없을 때만 사용, 이후 지워도 됩니다) ---
ID=
PW=

# --- 선택 ---
# 서비스가 노출될 주소. 끝에 반드시 / 를 붙이세요.
TARGET_URL=http://localhost:6824/
# 호스트에 열 포트 (컨테이너 내부 포트는 3000 고정)
APP_PORT=6824
# 메인 화면에 보여질 이름
SERVICE_NAME=MrShort
POSTGRES_USER=mrshort
POSTGRES_DB=urlshortener
